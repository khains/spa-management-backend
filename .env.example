# Copy file nay thanh ".env" va dien thong tin that

# Chuoi ket noi MongoDB Atlas
# Vi du: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/spa_management?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://nskhai3897_db_user:fsWMwDGRYpUQIEDD@cluster0.y4qepp1.mongodb.net/spa_management?retryWrites=true&w=majority

# Cong chay server
